---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  {
    q: "What does this Burnout Risk score mean?",
    a: "The score classifies your academic fatigue into Low, Medium, or High risk based on your AI usage, study hours, exam stress, and skill retention."
  },
  {
    q: "Is my personal data kept private?",
    a: "Yes, 100%. Everything runs locally on your computer or phone. Your GPA, study hours, and stress levels are never sent to a server or stored anywhere."
  },
  {
    q: "Why does relying heavily on AI sometimes increase exam anxiety?",
    a: "When AI generates answers quickly, our brains often experience the 'illusion of competence'—we understand the solution while reading it, but haven't built the neural pathways to recall it under exam conditions. This gap often leads to unexpected panic on test day."
  },
  {
    q: "What is a healthy balance between AI and traditional study?",
    a: "A healthy guideline is the 70/30 rule: spend 70% of your time on active recall (handwritten problem-solving, flashcards, explaining concepts out loud) and 30% using AI for synthesis, explanations, and practice questions."
  }
];

const pageTitle = "Student Burnout Risk Predictor | Machine Learning Assessment";
const pageDescription = "Assess your academic stress and AI study balance with a clean, private, in-browser machine learning assessment tool.";
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Load ONNX Runtime Web via CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.min.js"></script>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-10 pb-20">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
        <li><a href="/" class="hover:text-[var(--text-main)] transition">Home</a></li>
        <li><span>/</span></li>
        <li class="font-medium text-[var(--text-main)]" aria-current="page">Burnout Predictor</li>
      </ol>
    </nav>

    <!-- Header: Clean, Human, Simple -->
    <header class="mb-8 border-b border-[var(--border-subtle)] pb-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400">
        Academic Wellness Model
      </span>
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-[var(--text-main)] mt-1 mb-2">
        Student Burnout Risk Predictor
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-muted)] leading-relaxed">
        Adjust your study habits and stress levels below. The model will calculate whether your burnout risk is <strong>Low</strong>, <strong>Medium</strong>, or <strong>High</strong> with personalized guidance.
      </p>
    </header>

    <!-- Interactive Card -->
    <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface)] p-6 sm:p-8 shadow-sm">
      <form id="burnout-form" class="space-y-6" onsubmit="event.preventDefault();">
        
        <!-- GPA & Retention Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="gpa" class="text-xs font-semibold text-[var(--text-main)]">
                Current GPA
              </label>
              <span class="text-xs text-[var(--text-muted)]">Scale 1.0 – 4.0</span>
            </div>
            <input 
              type="number" 
              id="gpa" 
              value="3.20" 
              step="0.05" 
              min="1.0" 
              max="4.0" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] text-[var(--text-main)] text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 transition font-mono"
            />
          </div>

          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="retention" class="text-xs font-semibold text-[var(--text-main)]">
                Skill Retention: <span id="retention-display" class="font-bold text-purple-600 dark:text-purple-400 font-mono">75</span>%
              </label>
              <span class="text-xs text-[var(--text-muted)]">0 – 100%</span>
            </div>
            <input 
              type="range" 
              id="retention" 
              min="10" 
              max="100" 
              value="75" 
              class="w-full h-2 bg-[var(--border-subtle)] rounded-lg appearance-none cursor-pointer accent-purple-600 mt-3"
            />
          </div>
        </div>

        <!-- Study Hours Comparison -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2 border-t border-[var(--border-subtle)]">
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="genai-hours" class="text-xs font-semibold text-[var(--text-main)]">
                AI Study Hours (ChatGPT, Claude): <span id="genai-display" class="font-bold text-purple-600 dark:text-purple-400 font-mono">8</span> hrs/wk
              </label>
            </div>
            <input 
              type="range" 
              id="genai-hours" 
              min="0" 
              max="40" 
              value="8" 
              class="w-full h-2 bg-[var(--border-subtle)] rounded-lg appearance-none cursor-pointer accent-purple-600 mt-2"
            />
            <span class="text-[11px] text-[var(--text-muted)] block mt-1">Hours spent prompting, debugging, and reading AI summaries.</span>
          </div>

          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="study-hours" class="text-xs font-semibold text-[var(--text-main)]">
                Traditional Study (Books, Notes): <span id="study-display" class="font-bold text-purple-600 dark:text-purple-400 font-mono">14</span> hrs/wk
              </label>
            </div>
            <input 
              type="range" 
              id="study-hours" 
              min="1" 
              max="40" 
              value="14" 
              class="w-full h-2 bg-[var(--border-subtle)] rounded-lg appearance-none cursor-pointer accent-purple-600 mt-2"
            />
            <span class="text-[11px] text-[var(--text-muted)] block mt-1">Hours spent solving problems manually and reading textbooks.</span>
          </div>
        </div>

        <!-- Psychological / Emotional Factors -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2 border-t border-[var(--border-subtle)]">
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="ai-dep" class="text-xs font-semibold text-[var(--text-main)]">
                AI Dependency: <span id="dep-display" class="font-bold text-purple-600 dark:text-purple-400 font-mono">4</span> / 10
              </label>
            </div>
            <input 
              type="range" 
              id="ai-dep" 
              min="1" 
              max="10" 
              value="4" 
              class="w-full h-2 bg-[var(--border-subtle)] rounded-lg appearance-none cursor-pointer accent-purple-600 mt-2"
            />
            <div class="flex justify-between text-[11px] text-[var(--text-muted)] mt-1 font-mono">
              <span>1 (Independent)</span>
              <span>10 (Full Reliance)</span>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="anxiety" class="text-xs font-semibold text-[var(--text-main)]">
                Exam Anxiety Level: <span id="anxiety-display" class="font-bold text-purple-600 dark:text-purple-400 font-mono">5</span> / 10
              </label>
            </div>
            <input 
              type="range" 
              id="anxiety" 
              min="1" 
              max="10" 
              value="5" 
              class="w-full h-2 bg-[var(--border-subtle)] rounded-lg appearance-none cursor-pointer accent-purple-600 mt-2"
            />
            <div class="flex justify-between text-[11px] text-[var(--text-muted)] mt-1 font-mono">
              <span>1 (Calm)</span>
              <span>10 (Overwhelmed)</span>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <button 
            type="button" 
            id="predict-btn"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-white bg-purple-700 hover:bg-purple-800 transition cursor-pointer flex items-center justify-center gap-2 shadow-sm text-sm"
          >
            <span>Update Assessment</span>
            <span>→</span>
          </button>
        </div>
      </form>

      <!-- RESULTS SECTION: CLEAR LOW / MEDIUM / HIGH BADGE & CARDS -->
      <div id="result-box" class="mt-8 pt-6 border-t border-[var(--border-subtle)]">
        
        <!-- Big Visual Risk Indicator (LOW / MEDIUM / HIGH) -->
        <div class="p-6 rounded-2xl bg-[var(--surface-card)] border border-[var(--border-subtle)] mb-6 text-center">
          <span class="text-xs uppercase tracking-wider font-semibold text-[var(--text-muted)] block mb-2">
            Burnout Risk Assessment Output:
          </span>

          <!-- 3-Segment Visual Meter -->
          <div class="grid grid-cols-3 gap-2 max-w-sm mx-auto mb-4">
            <div id="badge-low" class="py-2 rounded-lg text-xs font-bold border transition-all bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500">
              LOW
            </div>
            <div id="badge-medium" class="py-2 rounded-lg text-xs font-bold border transition-all bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border-subtle)] opacity-50">
              MEDIUM
            </div>
            <div id="badge-high" class="py-2 rounded-lg text-xs font-bold border transition-all bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border-subtle)] opacity-50">
              HIGH
            </div>
          </div>

          <!-- Primary Output Text -->
          <div id="risk-headline" class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">
            LOW BURNOUT RISK
          </div>
          <p id="risk-subline" class="text-xs text-[var(--text-muted)] mt-1">
            Study habits and cognitive demands are currently well balanced.
          </p>
        </div>

        <!-- Personalized Action Plan -->
        <div class="space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
            Personalized Guidance & Advice:
          </h3>

          <!-- Advice Item 1: Overview -->
          <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-card)]">
            <h4 class="text-sm font-semibold text-[var(--text-main)] flex items-center gap-2 mb-1">
              <span>📋</span>
              <span id="overview-heading">Academic Health Summary</span>
            </h4>
            <p id="overview-text" class="text-sm text-[var(--text-muted)] leading-relaxed">
              Your study habits reflect a balanced routine. Your traditional study hours provide a strong foundation, keeping AI as an aid rather than an outsourced brain.
            </p>
          </div>

          <!-- Advice Item 2: AI vs Traditional Habit -->
          <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-card)]">
            <h4 class="text-sm font-semibold text-[var(--text-main)] flex items-center gap-2 mb-1">
              <span>⚖️</span>
              <span id="ratio-heading">AI & Study Ratio Strategy</span>
            </h4>
            <p id="ratio-text" class="text-sm text-[var(--text-muted)] leading-relaxed">
              Your ratio of traditional study to AI is sustainable. Continue doing pen-and-paper exercises before asking AI for hints.
            </p>
          </div>

          <!-- Advice Item 3: Exam Stress & Retention -->
          <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-card)]">
            <h4 class="text-sm font-semibold text-[var(--text-main)] flex items-center gap-2 mb-1">
              <span>🧠</span>
              <span id="stress-heading">Retention & Exam Strategy</span>
            </h4>
            <p id="stress-text" class="text-sm text-[var(--text-muted)] leading-relaxed">
              To keep exam anxiety low, practice active recall from blank sheets of paper without AI assistance before tests.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- FAQs -->
    <section class="mt-14 space-y-6">
      <h2 class="text-lg font-bold text-[var(--text-main)]">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="p-5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-card)]">
            <h3 class="font-semibold text-sm text-[var(--text-main)] mb-1">{faq.q}</h3>
            <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>

      <div class="pt-4 text-center">
        <a href="/" class="text-xs font-semibold text-purple-600 dark:text-purple-400 hover:underline">
          ← Back to All Models
        </a>
      </div>
    </section>
  </div>

  <!-- In-Browser Logic -->
  <script is:inline>
    let onnxSession = null;
    const modelUrl = '/models/burnout_model.onnx';

    // Inputs
    const gpaInput = document.getElementById('gpa');
    const genAiInput = document.getElementById('genai-hours');
    const genAiDisplay = document.getElementById('genai-display');
    const studyInput = document.getElementById('study-hours');
    const studyDisplay = document.getElementById('study-display');
    const depInput = document.getElementById('ai-dep');
    const depDisplay = document.getElementById('dep-display');
    const anxietyInput = document.getElementById('anxiety');
    const anxietyDisplay = document.getElementById('anxiety-display');
    const retentionInput = document.getElementById('retention');
    const retentionDisplay = document.getElementById('retention-display');

    // Result Badges & Elements
    const badgeLow = document.getElementById('badge-low');
    const badgeMedium = document.getElementById('badge-medium');
    const badgeHigh = document.getElementById('badge-high');
    const riskHeadline = document.getElementById('risk-headline');
    const riskSubline = document.getElementById('risk-subline');
    const overviewHeading = document.getElementById('overview-heading');
    const overviewText = document.getElementById('overview-text');
    const ratioHeading = document.getElementById('ratio-heading');
    const ratioText = document.getElementById('ratio-text');
    const stressHeading = document.getElementById('stress-heading');
    const stressText = document.getElementById('stress-text');
    const predictBtn = document.getElementById('predict-btn');

    // Keep displays live
    genAiInput?.addEventListener('input', e => { genAiDisplay.textContent = e.target.value; computeAssessment(); });
    studyInput?.addEventListener('input', e => { studyDisplay.textContent = e.target.value; computeAssessment(); });
    depInput?.addEventListener('input', e => { depDisplay.textContent = e.target.value; computeAssessment(); });
    anxietyInput?.addEventListener('input', e => { anxietyDisplay.textContent = e.target.value; computeAssessment(); });
    retentionInput?.addEventListener('input', e => { retentionDisplay.textContent = e.target.value; computeAssessment(); });
    gpaInput?.addEventListener('input', computeAssessment);

    // Initialize ONNX Model
    async function loadModel() {
      try {
        if (typeof ort !== 'undefined') {
          ort.env.wasm.numThreads = 1;
          onnxSession = await ort.InferenceSession.create(modelUrl, { executionProviders: ['wasm'] });
          computeAssessment();
        }
      } catch (e) {
        console.warn('Model initialized in browser rule mode:', e);
      }
    }

    async function computeAssessment() {
      const gpa = parseFloat(gpaInput.value) || 3.0;
      const genai = parseFloat(genAiInput.value) || 8;
      const study = parseFloat(studyInput.value) || 14;
      const dep = parseFloat(depInput.value) || 4;
      const anxiety = parseFloat(anxietyInput.value) || 5;
      const retention = parseFloat(retentionInput.value) || 75;

      let riskCategory = "Low"; // "Low", "Medium", "High"

      if (onnxSession) {
        try {
          const tensor = new ort.Tensor('float32', Float32Array.from([gpa, genai, study, dep, anxiety, retention]), [1, 6]);
          const output = await onnxSession.run({ float_input: tensor });
          const labelTensor = output.output_label || output[Object.keys(output)[0]];
          const classIdx = Number(labelTensor.data[0]);
          
          // In training: 0 = High, 1 = Low, 2 = Medium
          if (classIdx === 0) riskCategory = "High";
          else if (classIdx === 2) riskCategory = "Medium";
          else riskCategory = "Low";
        } catch (err) {
          riskCategory = evaluateRules(gpa, genai, study, dep, anxiety, retention);
        }
      } else {
        riskCategory = evaluateRules(gpa, genai, study, dep, anxiety, retention);
      }

      renderOutput(riskCategory, gpa, genai, study, dep, anxiety, retention);
    }

    // Direct mathematical rule boundary
    function evaluateRules(gpa, genai, study, dep, anxiety, retention) {
      if ((anxiety >= 7 && dep >= 6) || (genai >= 20 && anxiety >= 7) || (retention <= 45 && anxiety >= 8)) {
        return "High";
      }
      if (anxiety >= 5 || dep >= 5 || genai > study || retention <= 65) {
        return "Medium";
      }
      return "Low";
    }

    function renderOutput(risk, gpa, genai, study, dep, anxiety, retention) {
      // Reset meter badges to muted state
      badgeLow.className = "py-2 rounded-lg text-xs font-bold border transition-all bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border-subtle)] opacity-40";
      badgeMedium.className = "py-2 rounded-lg text-xs font-bold border transition-all bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border-subtle)] opacity-40";
      badgeHigh.className = "py-2 rounded-lg text-xs font-bold border transition-all bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border-subtle)] opacity-40";

      if (risk === "High") {
        // Highlight High Badge
        badgeHigh.className = "py-2 rounded-lg text-xs font-bold border transition-all bg-red-500/10 text-red-600 dark:text-red-400 border-red-500 opacity-100 ring-2 ring-red-500/20";
        
        riskHeadline.textContent = "HIGH BURNOUT RISK";
        riskHeadline.className = "text-2xl sm:text-3xl font-extrabold text-red-600 dark:text-red-400";
        riskSubline.textContent = "Warning: Severe study fatigue and exam anxiety detected.";

        overviewHeading.textContent = "High Cognitive Strain";
        overviewText.textContent = `Your assessment shows a High risk of burnout. Your high exam anxiety (${anxiety}/10) coupled with ${genai} hours of AI tool usage and high dependency (${dep}/10) indicates you are feeling overwhelmed. Relying on AI when stressed often gives a short-term feeling of progress that disappears under test conditions, compounding your anxiety.`;

        ratioHeading.textContent = "Immediate Action: Rebalance Your Study Hours";
        if (genai >= study) {
          ratioText.textContent = `You are currently spending ${genai} hours using AI versus only ${study} hours of traditional study. We strongly recommend reducing AI usage by 50% this week and dedicating that time to handwriting summaries and solving practice questions on paper.`;
        } else {
          ratioText.textContent = `Even with ${study} hours of traditional study, your high AI dependency (${dep}/10) suggests you are turning to AI whenever a problem gets tough. Set a 15-minute timer to struggle through hard problems independently before asking AI for a hint.`;
        }

        stressHeading.textContent = "Exam Stress & Memory Strategy";
        stressText.textContent = `With anxiety at ${anxiety}/10 and retention at ${retention}%, avoid last-minute cramming. Study in 25-minute focused bursts. Explain key concepts out loud without looking at any screen to prove to yourself that you know the material.`;

      } else if (risk === "Medium") {
        // Highlight Medium Badge
        badgeMedium.className = "py-2 rounded-lg text-xs font-bold border transition-all bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500 opacity-100 ring-2 ring-amber-500/20";

        riskHeadline.textContent = "MEDIUM BURNOUT RISK";
        riskHeadline.className = "text-2xl sm:text-3xl font-extrabold text-amber-600 dark:text-amber-400";
        riskSubline.textContent = "Notice: Manageable stress levels approaching burnout boundaries.";

        overviewHeading.textContent = "Moderate Cognitive Strain";
        overviewText.textContent = `Your assessment shows a Medium risk of burnout. You are managing your classes, but your stress markers (${anxiety}/10) and study habits suggest that exams feel tense and mentally draining.`;

        ratioHeading.textContent = "Optimize Your AI Leverage";
        ratioText.textContent = `You are spending ${genai} hours with AI and ${study} hours on independent study. Keep AI strictly for generating practice quizzes or clarifying confusing paragraphs, but close the AI tab when doing homework or practice exercises.`;

        stressHeading.textContent = "Proactive Exam Preparation";
        stressText.textContent = `To bring your anxiety down from ${anxiety}/10, simulate test conditions once a week: no notes, no AI, set a timer. This builds genuine test-day confidence and protects your GPA (${gpa}).`;

      } else {
        // Highlight Low Badge
        badgeLow.className = "py-2 rounded-lg text-xs font-bold border transition-all bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500 opacity-100 ring-2 ring-emerald-500/20";

        riskHeadline.textContent = "LOW BURNOUT RISK";
        riskHeadline.className = "text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400";
        riskSubline.textContent = "Optimal: Healthy study balance and sustainable cognitive load.";

        overviewHeading.textContent = "Healthy Academic Routine";
        overviewText.textContent = `Your metrics reflect a Low risk of burnout! You maintain solid retention (${retention}%), manageable stress levels (${anxiety}/10), and a healthy GPA (${gpa}) backed by balanced habits.`;

        ratioHeading.textContent = "Maintain Your Rhythm";
        ratioText.textContent = `Your ratio of ${study} traditional study hours to ${genai} AI hours is well-balanced. You are using AI as an accelerator rather than a replacement for thinking.`;

        stressHeading.textContent = "Long-Term Retention";
        stressText.textContent = `Continue spreading your study sessions across the week rather than pulling late nights. Good sleep is what locks in the neural connections you build while studying.`;
      }
    }

    predictBtn?.addEventListener('click', computeAssessment);

    // Initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        loadModel();
        computeAssessment();
      });
    } else {
      loadModel();
      computeAssessment();
    }
  </script>
</Layout>
